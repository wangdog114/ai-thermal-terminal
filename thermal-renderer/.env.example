RENDER_TOKEN=replace-with-a-long-random-secret

# 页面最大高度。20000px 大约对应 2.5 米纸张。
MAX_PAGE_HEIGHT=20000

# 最大 Markdown 字符数
MAX_MARKDOWN_CHARS=100000

# 可选。正文使用 Light，加粗使用 Normal；均为思源黑体。
PRINT_LIGHT_FONT_PATH=assets/fonts/SourceHanSansCN-Light.otf
PRINT_FONT_PATH=assets/fonts/SourceHanSansCN-Normal.otf

# 本地运行时可指定系统 Chrome
# Linux:
# CHROME_PATH=/usr/bin/google-chrome
#
# macOS:
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
