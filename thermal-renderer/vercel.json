{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "functions": {
    "api/render.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "assets/**"
    }
  },
  "routes": [
    {
      "src": "^/render$",
      "dest": "/api/render"
    },
    {
      "src": "^/health$",
      "dest": "/api/render?health=1"
    },
    {
      "src": "^/.*$",
      "status": 404
    }
  ]
}
